# PlateConnect Environment Variables
# Copy these into .env or set them in your deployment platform

# ==============================================================================
# FIREBASE WEB CONFIGURATION
# Obtain these values from your Firebase Console:
# 1. Go to https://console.firebase.google.com/
# 2. Select or create your project: (e.g. plateconnect-campus)
# 3. Project Settings (gear icon) -> General -> Your apps -> Click Web app (</>)
# 4. Copy the config values into the variables below:
# ==============================================================================
VITE_FIREBASE_API_KEY="AIzaSyYourApiKeyGoesHere..."
VITE_FIREBASE_AUTH_DOMAIN="plateconnect-campus.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="plateconnect-campus"
VITE_FIREBASE_STORAGE_BUCKET="plateconnect-campus.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# Note: Never place server-side service account private keys into client environment files!
